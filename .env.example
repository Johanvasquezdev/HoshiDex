NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Optional Express/Sequelize backend fallback from the original PDF structure.
# Leave empty when using Supabase for the maintenance screens.
NEXT_PUBLIC_POKEDEX_BACKEND_URL=

# Optional PokeAPI tuning.
POKEAPI_MAX_CONCURRENCY=3
POKEAPI_MIN_INTERVAL_MS=120
POKEAPI_MAX_RETRIES=2
